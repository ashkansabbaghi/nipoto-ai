# Copy to .env and fill in. Never commit .env.

ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                  # true in deployed envs
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://nipoto:nipoto@localhost:5433/nipoto_ai

# --- Auth (§6) ------------------------------------------------------------
JWT_AUDIENCE=nipoto-ai
# Dev: public key PEM file produced by `make keys`. Prod: JWKS_URL from the main backend.
JWT_PUBLIC_KEY_FILE=.keys/dev_public.pem
JWT_PRIVATE_KEY_FILE=.keys/dev_private.pem   # only used by scripts/mint_token.py and /demo/token
JWKS_URL=

# --- Main backend connector (§7) ------------------------------------------
MAIN_BACKEND=fake               # fake | http
MAIN_BACKEND_URL=
MAIN_BACKEND_TOKEN=
FAKE_BACKEND_DIR=data/fixtures/conversations

# --- LLM provider (§10) ---------------------------------------------------
LLM_PROVIDER=fake               # fake | openai_compat
LLM_BASE_URL=
LLM_API_KEY=
CHAT_MODEL=
SMALL_MODEL=

# --- Embeddings sidecar (D4) ----------------------------------------------
EMBEDDER=fake                   # fake | openai_compat
EMBEDDINGS_BASE_URL=http://localhost:8081/v1
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_API_KEY=

# --- Demo (M4, dev only) --------------------------------------------------
DEMO_ENABLED=true
